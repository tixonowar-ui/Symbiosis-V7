# --- dependencies ---
node_modules/

# --- build output ---
dist/
*.tsbuildinfo

# --- pipeline output that must NOT be committed ---
# generated/spec and generated/types ARE committed (see CLAUDE.md): they diff,
# and typecheck needs the types. media and seed are large binary output that
# does not diff, and tools/import rebuilds both byte for byte.
# See ADR 0016 and ADR 0019.
generated/media/
generated/seed/*.sqlite

# --- reports (coverage, traceability, playwright) ---
reports/
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# --- local databases ---
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# --- environment / secrets ---
.env
.env.*
!.env.example

# --- editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- misc caches ---
.vite/
.eslintcache
npm-debug.log*
