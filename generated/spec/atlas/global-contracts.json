      "events": [
        {
          "condition": "No active campaign scene",
          "event": "Open pre-campaign menu",
          "eventId": "EV-01",
          "requiredAction": "Activate POOL_MENU; preserve current menu track across menu screens."
        },
        {
          "condition": "Eligible group exists",
          "event": "Start/load campaign",
          "eventId": "EV-02",
          "requiredAction": "Resolve determining group, phase and zone; apply focus activation entry rules."
        },
        {
          "condition": "Marker enters a new zone",
          "event": "Place/move determining marker",
          "eventId": "EV-03",
          "requiredAction": "Re-resolve context. Settlement/location entry opener may force a switch."
        },
        {
          "condition": "Effective pool unchanged",
          "event": "Move within same zone",
          "eventId": "EV-04",
          "requiredAction": "Continue current track."
        },
        {
          "condition": "Largest group may change",
          "event": "Change group membership",
          "eventId": "EV-05",
          "requiredAction": "Recalculate headcount and determining group."
        },
        {
          "condition": "Group count tie possible",
          "event": "Create another group",
          "eventId": "EV-06",
          "requiredAction": "Use largest headcount; tie uses earlier creationSequence."
        },
        {
          "condition": "At least one active battle",
          "event": "Start battle",
          "eventId": "EV-07",
          "requiredAction": "Immediately activate determining battle music; night is ignored."
        },
        {
          "condition": "No active battles remain",
          "event": "End battle",
          "eventId": "EV-08",
          "requiredAction": "Re-evaluate current ambient context; no automatic city-entry replay."
        },
        {
          "condition": "No battle",
          "event": "Clock reaches 21:00",
          "eventId": "EV-09",
          "requiredAction": "Activate night context; only night-eligible tracks."
        },
        {
          "condition": "No battle",
          "event": "Clock reaches 06:00",
          "eventId": "EV-10",
          "requiredAction": "Activate day context; only day-eligible tracks."
        },
        {
          "condition": "Context unchanged",
          "event": "Track ends",
          "eventId": "EV-11",
          "requiredAction": "Take next item from effective shuffle bag."
        },
        {
          "condition": "Master reachable",
          "event": "Reconnect client",
          "eventId": "EV-12",
          "requiredAction": "Apply master track/offset/pool state; preserve local mute/volume."
        }
