      "rules": [
        {
          "area": "Source of truth",
          "requirement": "The master's computer owns the active logical track, playback position, start timestamp, active pool and shuffle-bag state. Clients reproduce this state.",
          "ruleId": "R-001"
        },
        {
          "area": "Priority",
          "requirement": "BATTLE > NIGHT AMBIENT > DAY AMBIENT. Menu music applies only on pre-campaign menu flows.",
          "ruleId": "R-002"
        },
        {
          "area": "Determining battle",
          "requirement": "Any active battle globally enables battle music. If several battles exist, use the battle involving the largest eligible group; ties use the older group.",
          "ruleId": "R-003"
        },
        {
          "area": "Determining group",
          "requirement": "Outside battle, use the location of the eligible group with the greatest headcount. Ties use immutable creationSequence ascending.",
          "ruleId": "R-004"
        },
        {
          "area": "Headcount",
          "requirement": "Count living active player characters and allied NPCs explicitly included in the group. Exclude enemies, dead characters and removed/inactive members.",
          "ruleId": "R-005"
        },
        {
          "area": "Location precedence",
          "requirement": "City/garrison circle > No-Man's coastal overlay > No-Man's polygon > faction territory > Sea. Nэйт is always a Pure city override.",
          "ruleId": "R-006"
        },
        {
          "area": "Night interval",
          "requirement": "Night is [21:00, 06:00). Day is [06:00, 21:00). Use campaign game time/dayPhase; master-set localLighting never changes the music phase.",
          "ruleId": "R-007"
        },
        {
          "area": "Context switch",
          "requirement": "Switch immediately with a 2,000 ms crossfade when battle, dayPhase, determining group or spatial context changes. At exactly 21:00 outside battle, resolve the night pool.",
          "ruleId": "R-008"
        },
        {
          "area": "Same-pool stability",
          "requirement": "Do not interrupt the current track when the effective pool remains unchanged, except for a required settlement/location entry opener.",
          "ruleId": "R-009"
        },
        {
          "area": "Settlement entry",
          "requirement": "On every new entry, marker placement or focus activation in a settlement, apply its entry rule. Movement within the same settlement does not restart music; exit and re-entry does.",
          "ruleId": "R-010"
        },
        {
          "area": "Local alternatives",
          "requirement": "Chado, Urahanta and Sadena choose randomly among their two local entry tracks. No separate Arena/Centre/Swamp sublocation field exists.",
          "ruleId": "R-011"
        },
        {
          "area": "Continuation",
          "requirement": "After an opener ends, use the location's continuation pool. Named city tracks may then appear in other cities of the same faction.",
          "ruleId": "R-012"
        },
        {
          "area": "Shuffle bag",
          "requirement": "Play every eligible track once before refilling the bag. Do not select the just-finished track when another option exists.",
          "ruleId": "R-013"
        },
        {
          "area": "Opener consumption",
          "requirement": "If an opener also belongs to the continuation pool, mark it as consumed in the current bag to prevent immediate repetition.",
          "ruleId": "R-014"
        },
        {
          "area": "Pure combat",
          "requirement": "If the determining battle includes at least one Pure participant, choose the first track from POOL_COMBAT_PURE_OPENERS, then use POOL_COMBAT_PURE_CONTINUATION.",
          "ruleId": "R-015"
        },
        {
          "area": "Combat exit",
          "requirement": "On battle end, re-evaluate group, phase and zone. Resume a random eligible ambient track; do not replay a city opener unless a new entry/focus activation occurred.",
          "ruleId": "R-016"
        },
        {
          "area": "Sea at night",
          "requirement": "On entering the Sea of Solitude at night, or when night begins at sea, play MUS-047 first, then POOL_SEA_NIGHT_CONTINUATION.",
          "ruleId": "R-017"
        },
        {
          "area": "No-Man's coast",
          "requirement": "On daytime entry to NML_COASTAL, play MUS-048 first, then POOL_NML_DAY. Other No-Man's names do not imply extra map subzones.",
          "ruleId": "R-018"
        },
        {
          "area": "Garrisons",
          "requirement": "All three red border garrisons are Free settlements and use the corresponding north/south Free city pools.",
          "ruleId": "R-019"
        },
        {
          "area": "Pure territory at night",
          "requirement": "Outside Pure cities at night, use POOL_PURE_OUTSIDE_NIGHT, which reuses all Pure city-night tracks.",
          "ruleId": "R-020"
        },
        {
          "area": "Duplicate audio",
          "requirement": "MUS-009 and MUS-041 have identical bytes. Keep two logical uses: menu and daytime Pure territory outside cities. Runtime asset deduplication is allowed.",
          "ruleId": "R-021"
        },
        {
          "area": "No groups",
          "requirement": "If a campaign has no eligible group and no battle, fade to silence. Do not invent a map location.",
          "ruleId": "R-022"
        },
        {
          "area": "Persistence",
          "requirement": "Persist active track, offset, pool, remaining shuffle bag and RNG state in the campaign save. Resume without reselecting on load.",
          "ruleId": "R-023"
        },
