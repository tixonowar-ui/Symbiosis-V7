{
  "name": "symbiosis-v7",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first LAN application with a single authoritative host (player / gm / system roles)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "checksums": "tsx tools/checksums/index.ts write",
    "checksums:verify": "tsx tools/checksums/index.ts verify",
    "verify": "npm run checksums:verify && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
