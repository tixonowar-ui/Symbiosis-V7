# Не запускать install-скрипты зависимостей.
#
# Без этого `npm ci` пытается собрать better-sqlite3 через node-gyp: у пакета
# есть binding.gyp и нет собственного install-скрипта, а для таких npm по
# умолчанию подставляет `node-gyp rebuild`. Сборка требует Visual Studio Build
# Tools и Python, чего на машине разработчика нет и быть не обязано — см.
# ADR 0002.
#
# Готовые бинарники лежат прямо в тарболе (prebuilds/win32-x64.node), и без
# запуска скриптов используются именно они. Проверено: better-sqlite3
# открывает БД, esbuild запускается — его бинарник приходит через
# optionalDependency @esbuild/win32-x64, а не через postinstall.
#
# Добавляешь зависимость, которой install-скрипт действительно нужен, —
# это повод для ADR, а не для снятия флага.
ignore-scripts=true

# Соблюдать поле engines из package.json.
#
# По умолчанию npm его игнорирует: диапазон в engines — объявление, а не
# гарантия. С этим флагом установка на неподходящей версии Node или npm
# останавливается, а не расходится тихо.
engine-strict=true
