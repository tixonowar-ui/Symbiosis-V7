# Соблюдать поле engines из package.json.
#
# По умолчанию npm его игнорирует: диапазон в engines — объявление, а не
# гарантия. С этим флагом установка на неподходящей версии Node или npm
# останавливается, а не расходится тихо.
engine-strict=true

# Install-скрипты НЕ отключаются глобально. Разрешения задаются по пакетам
# полем `allowScripts` в package.json, а непокрытые пакеты ловит CI —
# см. ADR 0002. Глобальный `ignore-scripts=true` тихо пропускал бы скрипт
# зависимости, которой он действительно нужен.
