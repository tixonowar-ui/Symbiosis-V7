# Владелец репозитория ревьюит всё и единственный жмёт Merge.
#
# @codex-agent — ПЛЕЙСХОЛДЕР. GitHub App владельцем кода быть не может:
# CODEOWNERS принимает только пользователей и команды. Заменить на реальный
# логин бот-аккаунта, под которым Codex открывает PR, либо удалить строки с
# ним. См. docs/process/setup-checklist.md, пункт 3.

*                       @tixonowar-ui

# --- Прикладной код: основной автор — Codex, ревьюер — владелец -------------
#
# Codex указан владельцем той части, которую он и пишет. На его собственные PR
# это не влияет: GitHub не запрашивает ревью у автора, поэтому запрос всё равно
# уйдёт владельцу по правилу `*`.

/src/                   @tixonowar-ui @codex-agent
/tests/                 @tixonowar-ui @codex-agent

# --- Границы: только владелец ----------------------------------------------

# Read-only источники правды. Изменение — только новой поставкой.
/artifacts/             @tixonowar-ui

# Вывод конвейера. Меняется прогоном npm run import, не руками.
/generated/             @tixonowar-ui

# Решения проекта. Принятый ADR не редактируется по существу.
/docs/adr/              @tixonowar-ui

# Процесс, инвентаризация, очередь задач.
/docs/                  @tixonowar-ui

# Конвейер и проверки — то, на чём держится доверие к данным.
/tools/import/          @tixonowar-ui
/tools/checksums/       @tixonowar-ui
/tools/validate/        @tixonowar-ui

# CI и шаблоны.
/.github/               @tixonowar-ui

# Конфигурация проверок. Ослабление ради прохождения задачи запрещено.
/eslint.config.js       @tixonowar-ui
/tsconfig.json          @tixonowar-ui
/tsconfig.base.json     @tixonowar-ui
/tsconfig.web.json      @tixonowar-ui
/vitest.config.ts       @tixonowar-ui
/playwright.config.ts   @tixonowar-ui
/.prettierrc.json       @tixonowar-ui
/.gitattributes         @tixonowar-ui
/package.json           @tixonowar-ui

# Контракт для агентов.
/AGENTS.md              @tixonowar-ui
/CLAUDE.md              @tixonowar-ui
